[infomation]
name = "GD-EOS"
version = "v0.0.0"
decription = "A Epic Online Services editor plugin for Godot."
author = "忘忧の (Daylily Zeleen)"
email = "daylily-zeleen@foxmail.com"
support_link = "https://afdian.com/a/Daylily-Zeleen"
repo = "https://github.com/Daylily-Zeleen/GD-EOS"
others = "诚接Godot游戏开发，欢迎邮件联系。/ Receive game development outsourcing, welcome to contact by email."

[configuration]
entry_symbol = "gdeos_editor_library_init"
compatibility_minimum = 4.2

[libraries]
linux.editor.x86_64 = "bin/editor/linux/libgdeos_editor.linux.x86_64.so"
windows.editor.x86_64 = "bin/editor/windows/libgdeos_editor.windows.x86_64.dll"
macos.editor = "bin/editor/macos/libgdeos_editor.macos.framework"
android.editor.arm64 = "bin/editor/android/libgdeos_editor.android.arm64.so"
android.editor.x86_64 = "bin/editor/android/libgdeos_editor.android.x86_64.so"
android.editor.arm32 = "bin/editor/android/libgdeos_editor.android.arm32.so"
android.editor.x86_32 = "bin/editor/android/libgdeos_editor.android.x86_32.so"
