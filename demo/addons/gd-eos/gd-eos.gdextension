[infomation]
name = "GD-EOS"
version = "v0.0.0"
decription = "A Epic Online Services plugin for Godot"
author = "忘忧の (Daylily Zeleen)"
email = "daylily-zeleen@foxmail.com"
support_link = "https://afdian.com/a/Daylily-Zeleen"
repo = "https://github.com/Daylily-Zeleen/GD-EOS"
others = "诚接Godot游戏开发，欢迎邮件联系。/ Receive game development outsourcing, welcome to contact by email."


[configuration]

entry_symbol = "gdeos_library_init"
compatibility_minimum = 4.2

[libraries]
linux.x86_64 = "bin/linux/libgdeos.linux.x86_64.so"
windows.x86_64 = "bin/windows/libgdeos.windows.x86_64.dll"
windows.x86_32 = "bin/windows/libgdeos.windows.x86_32.dll"
macos = "bin/macos/libgdeos.macos.framework"
ios = "bin/ios/libgdeos.ios.xcframework"
android.arm64 = "bin/android/libgdeos.android.arm64.so"
android.x86_64 = "bin/android/libgdeos.android.x86_64.so"
android.arm32 = "bin/android/libgdeos.android.arm32.so"
android.x86_32 = "bin/android/libgdeos.android.x86_32.so"

[dependencies]
windows.x86_64 = {"bin/windows/EOSSDK-Win64-Shipping.dll": "", "bin/windows/x64/xaudio2_9redist.dll": ""}
windows.x86_32 = {"bin/windows/EOSSDK-Win32-Shipping.dll": "", "bin/windows/x86/xaudio2_9redist.dll": ""}

macos = {"bin/macos/libEOSSDK-Mac-Shipping.dylib": ""}

linux.x86_64 = {"bin/linux/libEOSSDK-Linux-Shipping.so": ""}

ios = {"bin/ios/libgodot-cpp.ios.xcframework": "", "bin/ios/EOSSDK.xcframework": ""}